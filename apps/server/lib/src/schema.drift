CREATE TABLE users (id TEXT NOT NULL PRIMARY KEY, name TEXT NOT NULL, role TEXT NOT NULL, department TEXT);
CREATE TABLE folders (id TEXT NOT NULL PRIMARY KEY, name TEXT NOT NULL CHECK(length(trim(name))>0), parent TEXT REFERENCES folders(id) ON DELETE RESTRICT, area TEXT NOT NULL, created TEXT NOT NULL, updated TEXT NOT NULL, revision INTEGER NOT NULL DEFAULT 1);
CREATE UNIQUE INDEX folder_names ON folders(area, coalesce(parent,''), name COLLATE NOCASE);
CREATE TABLE documents (id TEXT NOT NULL PRIMARY KEY, name TEXT NOT NULL, folder TEXT NOT NULL REFERENCES folders(id) ON DELETE RESTRICT, type TEXT NOT NULL, mime TEXT NOT NULL, size INTEGER NOT NULL CHECK(size>0), storage TEXT NOT NULL UNIQUE, status TEXT NOT NULL DEFAULT 'Aguardando conferência', note TEXT NOT NULL DEFAULT '', uploader TEXT NOT NULL REFERENCES users(id), created TEXT NOT NULL, updated TEXT NOT NULL, revision INTEGER NOT NULL DEFAULT 1);
CREATE TABLE requests (id TEXT NOT NULL PRIMARY KEY, protocol TEXT NOT NULL UNIQUE, service TEXT NOT NULL, subject TEXT NOT NULL, description TEXT NOT NULL, requester TEXT NOT NULL REFERENCES users(id), department TEXT NOT NULL CHECK(department IN ('secretaria','coordenacao')), state TEXT NOT NULL CHECK(state IN ('Recebida','Em atendimento','Aguardando solicitante','Concluída')), result TEXT NOT NULL DEFAULT '', operation TEXT NOT NULL, student TEXT REFERENCES students(id), created TEXT NOT NULL, updated TEXT NOT NULL, revision INTEGER NOT NULL DEFAULT 1, UNIQUE(requester,operation));
CREATE TABLE events (id TEXT NOT NULL PRIMARY KEY, request TEXT NOT NULL REFERENCES requests(id) ON DELETE CASCADE, actor TEXT NOT NULL REFERENCES users(id), text TEXT NOT NULL, created TEXT NOT NULL);
CREATE TABLE attachments (request TEXT NOT NULL REFERENCES requests(id) ON DELETE CASCADE, document TEXT NOT NULL REFERENCES documents(id) ON DELETE RESTRICT, PRIMARY KEY(request,document));
CREATE TABLE document_templates (id TEXT NOT NULL PRIMARY KEY, name TEXT NOT NULL UNIQUE COLLATE NOCASE, documents_json TEXT NOT NULL, fields_json TEXT NOT NULL, archived INTEGER NOT NULL DEFAULT 0 CHECK(archived IN (0,1)), revision INTEGER NOT NULL DEFAULT 1);
CREATE TABLE students (id TEXT NOT NULL PRIMARY KEY, name TEXT NOT NULL CHECK(length(trim(name))>0), registration TEXT UNIQUE COLLATE NOCASE, birth_date TEXT NOT NULL DEFAULT '', sex TEXT NOT NULL DEFAULT '' CHECK(sex IN ('','Feminino','Masculino','Intersexo','Não informado')), social_name TEXT NOT NULL DEFAULT '', birthplace TEXT NOT NULL DEFAULT '', nationality TEXT NOT NULL DEFAULT '', parentage TEXT NOT NULL DEFAULT '', address TEXT NOT NULL DEFAULT '', guardian TEXT NOT NULL DEFAULT '', phone TEXT NOT NULL DEFAULT '', email TEXT NOT NULL DEFAULT '', notes TEXT NOT NULL DEFAULT '', extra_json TEXT NOT NULL DEFAULT '{}', template TEXT REFERENCES document_templates(id), template_fields_json TEXT NOT NULL DEFAULT '{}', folder TEXT NOT NULL UNIQUE REFERENCES folders(id) ON DELETE RESTRICT, created TEXT NOT NULL, updated TEXT NOT NULL, revision INTEGER NOT NULL DEFAULT 1);
CREATE TABLE requirements (id TEXT NOT NULL PRIMARY KEY, student TEXT NOT NULL REFERENCES students(id) ON DELETE CASCADE, type TEXT NOT NULL CHECK(length(trim(type))>0), UNIQUE(student,type COLLATE NOCASE));
CREATE INDEX documents_by_folder_type ON documents(folder,type COLLATE NOCASE,status);
CREATE TABLE credentials (user TEXT NOT NULL PRIMARY KEY REFERENCES users(id), login TEXT NOT NULL UNIQUE COLLATE NOCASE, salt TEXT NOT NULL, password_hash TEXT NOT NULL, enabled INTEGER NOT NULL DEFAULT 1 CHECK(enabled IN (0,1)), revision INTEGER NOT NULL DEFAULT 1);
CREATE TABLE sessions (token_hash TEXT NOT NULL PRIMARY KEY, user TEXT NOT NULL REFERENCES users(id), expires TEXT NOT NULL);
CREATE TABLE student_access (student TEXT NOT NULL REFERENCES students(id) ON DELETE CASCADE, user TEXT NOT NULL REFERENCES users(id), PRIMARY KEY(student,user));
CREATE TABLE courses (id TEXT NOT NULL PRIMARY KEY, name TEXT NOT NULL, modality TEXT NOT NULL, duration_label TEXT NOT NULL DEFAULT '', template TEXT REFERENCES document_templates(id), archived INTEGER NOT NULL DEFAULT 0 CHECK(archived IN (0,1)), revision INTEGER NOT NULL DEFAULT 1, UNIQUE(name COLLATE NOCASE,modality COLLATE NOCASE));
CREATE TABLE class_groups (id TEXT NOT NULL PRIMARY KEY, course TEXT NOT NULL REFERENCES courses(id), name TEXT NOT NULL, school_year INTEGER NOT NULL CHECK(school_year BETWEEN 2000 AND 2200), period_label TEXT NOT NULL, grade TEXT NOT NULL, shift TEXT NOT NULL, capacity INTEGER NOT NULL CHECK(capacity BETWEEN 1 AND 200), archived INTEGER NOT NULL DEFAULT 0 CHECK(archived IN (0,1)), created TEXT NOT NULL, updated TEXT NOT NULL, revision INTEGER NOT NULL DEFAULT 1, UNIQUE(course,school_year,period_label,name COLLATE NOCASE));
CREATE TABLE enrollments (id TEXT NOT NULL PRIMARY KEY, student TEXT NOT NULL REFERENCES students(id), class_group TEXT NOT NULL REFERENCES class_groups(id), course TEXT NOT NULL REFERENCES courses(id), school_year INTEGER NOT NULL, period_label TEXT NOT NULL, state TEXT NOT NULL CHECK(state IN ('Em análise','Ativa','Transferida','Cancelada','Encerrada')), created TEXT NOT NULL, updated TEXT NOT NULL, revision INTEGER NOT NULL DEFAULT 1, UNIQUE(student,course,school_year,period_label));
CREATE TABLE enrollment_events (id TEXT NOT NULL PRIMARY KEY, enrollment TEXT NOT NULL REFERENCES enrollments(id), actor TEXT NOT NULL REFERENCES users(id), message TEXT NOT NULL, created TEXT NOT NULL);
CREATE INDEX enrollment_class_state ON enrollments(class_group,state);
CREATE TABLE journals (id TEXT NOT NULL PRIMARY KEY, class_group TEXT NOT NULL REFERENCES class_groups(id), subject TEXT NOT NULL, teacher TEXT NOT NULL REFERENCES users(id), component TEXT REFERENCES course_components(id), revision INTEGER NOT NULL DEFAULT 1, UNIQUE(class_group,component));
CREATE TABLE lessons (id TEXT NOT NULL PRIMARY KEY, journal TEXT NOT NULL REFERENCES journals(id), date TEXT NOT NULL, units INTEGER NOT NULL CHECK(units BETWEEN 1 AND 20), content TEXT NOT NULL, state TEXT NOT NULL CHECK(state IN ('Rascunho','Em revisão','Publicado')), revision INTEGER NOT NULL DEFAULT 1, created TEXT NOT NULL, updated TEXT NOT NULL);
CREATE TABLE attendance (lesson TEXT NOT NULL REFERENCES lessons(id), enrollment TEXT NOT NULL REFERENCES enrollments(id), status TEXT NOT NULL CHECK(status IN ('Presente','Ausente','Justificada')), PRIMARY KEY(lesson,enrollment));
CREATE TABLE lesson_events (id TEXT NOT NULL PRIMARY KEY, lesson TEXT NOT NULL REFERENCES lessons(id), actor TEXT NOT NULL REFERENCES users(id), message TEXT NOT NULL, created TEXT NOT NULL);

CREATE TABLE subjects (id TEXT NOT NULL PRIMARY KEY, name TEXT NOT NULL UNIQUE COLLATE NOCASE, code TEXT NOT NULL DEFAULT '', revision INTEGER NOT NULL DEFAULT 1);
CREATE TABLE course_components (id TEXT NOT NULL PRIMARY KEY, course TEXT NOT NULL REFERENCES courses(id), phase TEXT NOT NULL, subject TEXT NOT NULL REFERENCES subjects(id), hours INTEGER NOT NULL CHECK(hours BETWEEN 1 AND 5000), lesson_minutes INTEGER NOT NULL CHECK(lesson_minutes BETWEEN 15 AND 120), revision INTEGER NOT NULL DEFAULT 1, UNIQUE(course,phase COLLATE NOCASE,subject));
CREATE TABLE teacher_profiles (user TEXT NOT NULL PRIMARY KEY REFERENCES users(id), staff_code TEXT UNIQUE COLLATE NOCASE, qualification TEXT NOT NULL DEFAULT '', phone TEXT NOT NULL DEFAULT '', email TEXT NOT NULL DEFAULT '', revision INTEGER NOT NULL DEFAULT 1);
CREATE TABLE timetable_slots (id TEXT NOT NULL PRIMARY KEY, journal TEXT NOT NULL REFERENCES journals(id), weekday INTEGER NOT NULL CHECK(weekday BETWEEN 1 AND 7), start_minute INTEGER NOT NULL CHECK(start_minute BETWEEN 0 AND 1439), end_minute INTEGER NOT NULL CHECK(end_minute BETWEEN 1 AND 1440 AND end_minute>start_minute), valid_from TEXT NOT NULL, valid_to TEXT NOT NULL CHECK(valid_to>=valid_from), room TEXT NOT NULL DEFAULT '', revision INTEGER NOT NULL DEFAULT 1);
CREATE TABLE assessments (id TEXT NOT NULL PRIMARY KEY, journal TEXT NOT NULL REFERENCES journals(id), label TEXT NOT NULL, stage TEXT NOT NULL, held_on TEXT NOT NULL, max_score REAL NOT NULL CHECK(max_score>0 AND max_score<=1000), weight REAL NOT NULL CHECK(weight>0 AND weight<=100), state TEXT NOT NULL CHECK(state IN ('Rascunho','Em revisão','Publicado')), revision INTEGER NOT NULL DEFAULT 1, updated TEXT NOT NULL);
CREATE TABLE grades (assessment TEXT NOT NULL REFERENCES assessments(id), enrollment TEXT NOT NULL REFERENCES enrollments(id), score REAL, status TEXT NOT NULL CHECK(status IN ('Pendente','Lançada','Ausente','Dispensada')), note TEXT NOT NULL DEFAULT '', PRIMARY KEY(assessment,enrollment), CHECK((status='Lançada' AND score IS NOT NULL AND score>=0) OR (status<>'Lançada' AND score IS NULL)));
CREATE TABLE assessment_events (id TEXT NOT NULL PRIMARY KEY, assessment TEXT NOT NULL REFERENCES assessments(id), actor TEXT NOT NULL REFERENCES users(id), message TEXT NOT NULL, created TEXT NOT NULL);
CREATE TABLE absence_justifications (id TEXT NOT NULL PRIMARY KEY, lesson TEXT NOT NULL, enrollment TEXT NOT NULL, requester TEXT NOT NULL REFERENCES users(id), reason TEXT NOT NULL, document TEXT REFERENCES documents(id) ON DELETE RESTRICT, state TEXT NOT NULL CHECK(state IN ('Recebida','Deferida','Indeferida')), response TEXT NOT NULL DEFAULT '', reviewer TEXT REFERENCES users(id), created TEXT NOT NULL, updated TEXT NOT NULL, revision INTEGER NOT NULL DEFAULT 1, FOREIGN KEY(lesson,enrollment) REFERENCES attendance(lesson,enrollment), UNIQUE(lesson,enrollment));
